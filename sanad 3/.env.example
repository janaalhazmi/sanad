# Copy this file to `.env` and fill in your own key. Never commit the real `.env`.
#
# Optional — enables the AI fallback layer (general Q&A / recommendations
# beyond the trained local intents) and the OpenAI TTS secondary voice
# provider. The app runs fine without it: the assistant still works via the
# local NLU, and edge-tts remains the default voice with no key required.
OPENAI_API_KEY=
